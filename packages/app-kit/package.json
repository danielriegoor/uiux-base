{
  "name": "uiux-base-app-kit",
  "version": "0.1.0",
  "description": "Shell, navigation and visual application states for uiux-base.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielriegoor/uiux-base.git",
    "directory": "packages/app-kit"
  },
  "homepage": "https://github.com/danielriegoor/uiux-base#readme",
  "bugs": {
    "url": "https://github.com/danielriegoor/uiux-base/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "lucide-react": "^1.21.0"
  }
}
