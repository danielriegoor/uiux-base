{
  "name": "uiux-base-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "build:packages": "npm run build --workspace uiux-base-app-kit && npm run build --workspace uiux-base && npm run build --workspace @uiux-base/config",
    "build:apps": "npm run build --workspace starter && npm run build --workspace demo",
    "build": "npm run build:packages && npm run build:apps",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test": "npm run build:packages && npm run test:workspaces",
    "check:package": "node scripts/check-package.mjs",
    "lint:packages": "publint packages/app-kit && publint packages/ui",
    "check:types": "node scripts/check-types.mjs",
    "check": "npm run lint && npm run tokens:check && npm run build:packages && npm run typecheck && npm run test:workspaces && npm run build:apps && npm run check:package && npm run lint:packages && npm run check:types",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:check": "npm run check && node scripts/check-release-version.mjs",
    "publish:packages": "npm publish --workspace uiux-base-app-kit --access public && npm publish --workspace uiux-base --access public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "publint": "^0.3.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
